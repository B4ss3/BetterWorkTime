<Application x:Class="BetterWorkTime.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>

        <!-- ── Colour tokens ──────────────────────────────────────────── -->
        <!-- Steel-blue accent — muted, not vivid -->
        <SolidColorBrush x:Key="AccentBrush"       Color="#4A7FA5"/>
        <SolidColorBrush x:Key="AccentDarkBrush"   Color="#2E5F80"/>
        <SolidColorBrush x:Key="AccentLightBrush"  Color="#D6E8F4"/>
        <SolidColorBrush x:Key="AccentSubtleBrush" Color="#EBF4FA"/>

        <!-- Header -->
        <SolidColorBrush x:Key="HeaderBrush"       Color="#252B35"/>

        <!-- Surfaces -->
        <SolidColorBrush x:Key="PageBgBrush"       Color="#F2F3F5"/>
        <SolidColorBrush x:Key="CardBgBrush"       Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SubtleBgBrush"     Color="#F7F8FA"/>

        <!-- Borders -->
        <SolidColorBrush x:Key="BorderBrush"       Color="#DDE1E7"/>
        <SolidColorBrush x:Key="BorderDarkBrush"   Color="#C8CDD6"/>

        <!-- Text -->
        <SolidColorBrush x:Key="TextPrimaryBrush"  Color="#1C2028"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#5C6578"/>
        <SolidColorBrush x:Key="TextMutedBrush"    Color="#9AA1B0"/>

        <!-- State colours — muted tones -->
        <SolidColorBrush x:Key="GreenBrush"        Color="#3D8B5E"/>
        <SolidColorBrush x:Key="GreenBorderBrush"  Color="#2E7050"/>
        <SolidColorBrush x:Key="RedBrush"          Color="#A84040"/>
        <SolidColorBrush x:Key="RedBorderBrush"    Color="#8C3030"/>
        <SolidColorBrush x:Key="PurpleBrush"       Color="#6B5B9E"/>
        <SolidColorBrush x:Key="PurpleBorderBrush" Color="#564A85"/>

        <!-- ── Window ─────────────────────────────────────────────────── -->
        <Style TargetType="Window">
            <Setter Property="Background"  Value="{StaticResource PageBgBrush}"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <!-- ── TextBox ───────────────────────────────────────────────── -->
        <Style TargetType="TextBox">
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"      Value="{StaticResource CardBgBrush}"/>
            <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding"         Value="7,6"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── ComboBox ──────────────────────────────────────────────── -->
        <Style TargetType="ComboBox">
            <Setter Property="BorderBrush"  Value="{StaticResource BorderBrush}"/>
            <Setter Property="Background"   Value="{StaticResource CardBgBrush}"/>
            <Setter Property="Foreground"   Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Padding"      Value="7,6"/>
            <Setter Property="FontSize"     Value="13"/>
        </Style>

        <!-- ── CheckBox ──────────────────────────────────────────────── -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ── Separator ─────────────────────────────────────────────── -->
        <Style TargetType="Separator">
            <Setter Property="Background"  Value="{StaticResource BorderBrush}"/>
            <Setter Property="Height"      Value="1"/>
            <Setter Property="Margin"      Value="0,8,0,8"/>
        </Style>

        <!-- ── Shared button template helper ─────────────────────────── -->
        <!-- Solid coloured button (bg + matching border) -->
        <Style x:Key="BtnSolid" TargetType="Button">
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.74"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Coloured solid variants -->
        <Style x:Key="BtnBlue" BasedOn="{StaticResource BtnSolid}" TargetType="Button">
            <Setter Property="Background"   Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource AccentDarkBrush}"/>
        </Style>
        <Style x:Key="BtnGreen" BasedOn="{StaticResource BtnSolid}" TargetType="Button">
            <Setter Property="Background"   Value="{StaticResource GreenBrush}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource GreenBorderBrush}"/>
        </Style>
        <Style x:Key="BtnRed" BasedOn="{StaticResource BtnSolid}" TargetType="Button">
            <Setter Property="Background"   Value="{StaticResource RedBrush}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource RedBorderBrush}"/>
        </Style>
        <Style x:Key="BtnPurple" BasedOn="{StaticResource BtnSolid}" TargetType="Button">
            <Setter Property="Background"   Value="{StaticResource PurpleBrush}"/>
            <Setter Property="BorderBrush"  Value="{StaticResource PurpleBorderBrush}"/>
        </Style>

        <!-- Outline / ghost button — clear border, dark text -->
        <Style x:Key="BtnOutline" TargetType="Button">
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="FontWeight"      Value="Normal"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Background"      Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderDarkBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource SubtleBgBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger outline -->
        <Style x:Key="BtnDanger" BasedOn="{StaticResource BtnOutline}" TargetType="Button">
            <Setter Property="Foreground"  Value="{StaticResource RedBrush}"/>
            <Setter Property="BorderBrush" Value="#E0AAAA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FDF1F1"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource RedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header ghost — for use on dark header bar -->
        <Style x:Key="BtnHeaderOutline" BasedOn="{StaticResource BtnOutline}" TargetType="Button">
            <Setter Property="Foreground"  Value="#C8D0DC"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#4A5568"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2E3847"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#6B7A8D"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1E2535"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav button — active state set in code-behind via BorderThickness/Background -->
        <Style x:Key="BtnNav" BasedOn="{StaticResource BtnHeaderOutline}" TargetType="Button">
            <Setter Property="Padding"          Value="12,6"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="BorderThickness"  Value="0,0,0,2"/>
            <Setter Property="BorderBrush"      Value="Transparent"/>
        </Style>

        <!-- ── Card ──────────────────────────────────────────────────── -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"      Value="{StaticResource CardBgBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius"    Value="6"/>
            <Setter Property="Padding"         Value="14,12"/>
            <Setter Property="Margin"          Value="0,0,0,10"/>
        </Style>

        <!-- ── Label styles ──────────────────────────────────────────── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11.5"/>
            <Setter Property="Foreground"   Value="{StaticResource TextMutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- ── TabControl ────────────────────────────────────────────── -->
        <Style TargetType="TabControl">
            <Setter Property="Background"      Value="{StaticResource PageBgBrush}"/>
            <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
            <Setter Property="Padding"         Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Foreground"      Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Application.Resources>
</Application>
