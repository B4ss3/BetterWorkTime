<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1</AssemblyVersion>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationIcon>spedometer.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="spedometer.ico"  CopyToOutputDirectory="PreserveNewest" />
    <Content Include="changelog.json"  CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BetterWorkTime.Core\BetterWorkTime.Core.csproj" />
    <ProjectReference Include="..\BetterWorkTime.Data\BetterWorkTime.Data.csproj" />
    <ProjectReference Include="..\BetterWorkTime.Platform.Windows\BetterWorkTime.Platform.Windows.csproj" />
  </ItemGroup>

</Project>
