<Window x:Class="BetterWorkTime.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterWorkTime — Help"
        Width="520" Height="560"
        MinWidth="400" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <DockPanel Margin="0">

        <Border DockPanel.Dock="Bottom"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,1,0,0" Padding="12,10">
            <Button Content="Close" Width="80" HorizontalAlignment="Right"
                    IsCancel="True" Click="Close_Click"/>
        </Border>

        <TabControl x:Name="Tabs" Margin="0">

            <!-- ── Getting Started ── -->
            <TabItem Header="Getting Started">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <StackPanel>

                        <TextBlock Text="Welcome to BetterWorkTime!"
                                   FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>

                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
BetterWorkTime lives in your <Bold>system tray</Bold> (bottom-right corner). Left-click the icon to open the main window; right-click for a quick menu.
                        </TextBlock>

                        <TextBlock Text="Tracking time" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
Pick a <Bold>Project</Bold>, optionally fill in a <Bold>Task</Bold> name and select <Bold>Tags</Bold>, then hit <Bold>Start</Bold>. The timer runs until you click <Bold>Stop</Bold> or <Bold>Switch Task</Bold>. Today's entries appear in the timeline below the buttons.
                        </TextBlock>

                        <TextBlock Text="Projects, Tasks &amp; Tags" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
Click <Bold>Manage…</Bold> to create projects and tags, pick a colour for each, and archive ones you no longer need. Tasks are free-text — just type one in the Task field and it is created automatically.
                        </TextBlock>

                        <TextBlock Text="Idle detection" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
If you step away, the app detects it and asks what to do with the idle time — <Bold>Keep</Bold> it, <Bold>Discard</Bold> it, or <Bold>Split</Bold> the entry so idle time is logged separately. The threshold is set in <Bold>Settings → Tracking</Bold>.
                        </TextBlock>

                        <TextBlock Text="Reports &amp; Export" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
Click <Bold>Reports…</Bold> to see time broken down by project, filter by date or note, and export everything to CSV.
                        </TextBlock>

                        <TextBlock Text="Settings" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
Click <Bold>Settings…</Bold> to configure:
                        </TextBlock>
                        <StackPanel Margin="12,0,0,10">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">• <Bold>General</Bold> — start minimised to tray, global hotkeys</TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">• <Bold>Tracking</Bold> — idle detection threshold</TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">• <Bold>Hydration</Bold> — reminder interval and sound</TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">• <Bold>Export</Bold> — default folder and post-export behaviour</TextBlock>
                        </StackPanel>

                        <TextBlock Text="Custom hydration sounds" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,6">
You can use any <Bold>.wav</Bold> file as your hydration reminder sound. To set one up:
                        </TextBlock>
                        <StackPanel Margin="12,0,0,10">
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">1. Open <Bold>Settings → Hydration</Bold></TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">2. In the Sound dropdown, choose <Bold>Browse…</Bold></TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">3. Pick any <Bold>.wav</Bold> file from your computer</TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">4. Click <Bold>Preview</Bold> to test it before saving</TextBlock>
                            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">5. Click <Bold>Save</Bold> — the sound is remembered for future reminders</TextBlock>
                        </StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10">
The built-in options (Chimes, Chord, Notify) use Windows system sounds and require no extra files. Your custom file path is stored in settings and must remain accessible on disk.
                        </TextBlock>

                        <TextBlock Text="Hotkeys (optional)" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">Enable global hotkeys in <Bold>Settings → General</Bold>:</TextBlock>
                        <StackPanel Margin="12,4,0,10">
                            <TextBlock Margin="0,0,0,2">• Ctrl+Alt+S — Start / Stop</TextBlock>
                            <TextBlock Margin="0,0,0,2">• Ctrl+Alt+T — Switch Task</TextBlock>
                            <TextBlock Margin="0,0,0,2">• Ctrl+Alt+O — Open main window</TextBlock>
                            <TextBlock Margin="0,0,0,2">• Ctrl+Alt+N — Add note to running entry</TextBlock>
                        </StackPanel>

                        <TextBlock Text="Your data" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,4">
All data is stored locally at:
                        </TextBlock>
                        <TextBlock Text="%LOCALAPPDATA%\BetterWorkTime\" FontFamily="Consolas"
                                   Margin="12,0,0,10" TextWrapping="Wrap"/>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── What's New ── -->
            <TabItem Header="What's New" x:Name="WhatsNewTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,12">
                    <TextBlock x:Name="ChangelogText" TextWrapping="Wrap" FontFamily="Segoe UI"/>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
