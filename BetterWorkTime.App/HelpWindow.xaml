<Window x:Class="BetterWorkTime.App.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BetterWorkTime — Help"
        Width="540" Height="600"
        MinWidth="420" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFF"/>
            <Setter Property="BorderBrush" Value="#DBEAFE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="SectionAccent" TargetType="Border">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Width" Value="4"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#1D4ED8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Body" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="BulletRow" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
        <Style x:Key="BulletDot" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#3B82F6"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
        <Style x:Key="BulletText" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SubtleBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="14,10">
            <Button Content="Close" Width="84" HorizontalAlignment="Right"
                    IsCancel="True" Click="Close_Click"
                    Style="{StaticResource BtnOutline}" Padding="0,6"/>
        </Border>

        <TabControl x:Name="Tabs">

            <!-- ── Getting Started ── -->
            <TabItem Header="Getting Started">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,14,16,16">

                        <!-- Welcome banner -->
                        <Border Background="#1D4ED8" CornerRadius="8" Padding="16,14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="👋  Welcome to BetterWorkTime!"
                                           FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#BFDBFE"
                                           FontSize="12.5" Margin="0,6,0,0">
The app lives in your <Bold><Span Foreground="White">system tray</Span></Bold> (bottom-right corner).
Left-click the icon to open this window; right-click for a quick menu.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Tracking time -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel>
                                    <Border Style="{StaticResource SectionAccent}"/>
                                    <TextBlock Text="⏱  Tracking time" Style="{StaticResource SectionTitle}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Body}">
Pick a <Bold>Project</Bold>, optionally add a <Bold>Task</Bold> name and select <Bold>Tags</Bold>,
then press <Bold>Start</Bold>. The timer runs until you press <Bold>Stop</Bold> or <Bold>Switch Task</Bold>.
Today's entries appear in the timeline below the buttons.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Projects, Tasks & Tags -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel>
                                    <Border Style="{StaticResource SectionAccent}"/>
                                    <TextBlock Text="🗂  Projects, Tasks &amp; Tags" Style="{StaticResource SectionTitle}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Body}">
Click <Bold>Manage…</Bold> to create projects and tags, pick a colour for each, and archive ones
you no longer need. Tasks are free-text — just type in the Task field and they are saved automatically.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Idle detection -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel>
                                    <Border Style="{StaticResource SectionAccent}"/>
                                    <TextBlock Text="💤  Idle detection" Style="{StaticResource SectionTitle}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Body}">
If you step away, the app detects it and asks what to do — <Bold>Keep</Bold> the idle time,
<Bold>Discard</Bold> it, or <Bold>Split</Bold> so idle is logged separately.
Adjust the threshold in <Bold>Settings → Tracking</Bold>.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Reports & Export -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel>
                                    <Border Style="{StaticResource SectionAccent}"/>
                                    <TextBlock Text="📊  Reports &amp; Export" Style="{StaticResource SectionTitle}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Body}">
Click <Bold>Reports…</Bold> to see time broken down by project, filter by date range or note,
and export everything to <Bold>CSV</Bold>.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Settings -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel>
                                    <Border Style="{StaticResource SectionAccent}"/>
                                    <TextBlock Text="⚙  Settings" Style="{StaticResource SectionTitle}"/>
                                </DockPanel>
                                <StackPanel Margin="14,8,0,0">
                                    <DockPanel Style="{StaticResource BulletRow}">
                                        <TextBlock Text="→" Style="{StaticResource BulletDot}"/>
                                        <TextBlock Style="{StaticResource BulletText}"><Bold>General</Bold> — start minimised to tray, global hotkeys</TextBlock>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource BulletRow}">
                                        <TextBlock Text="→" Style="{StaticResource BulletDot}"/>
                                        <TextBlock Style="{StaticResource BulletText}"><Bold>Tracking</Bold> — idle detection threshold</TextBlock>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource BulletRow}">
                                        <TextBlock Text="→" Style="{StaticResource BulletDot}"/>
                                        <TextBlock Style="{StaticResource BulletText}"><Bold>Hydration</Bold> — reminder interval and sound</TextBlock>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource BulletRow}">
                                        <TextBlock Text="→" Style="{StaticResource BulletDot}"/>
                                        <TextBlock Style="{StaticResource BulletText}"><Bold>Export</Bold> — default folder and post-export behaviour</TextBlock>
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Hydration sounds -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel>
                                    <Border Style="{StaticResource SectionAccent}"/>
                                    <TextBlock Text="🔔  Custom hydration sounds" Style="{StaticResource SectionTitle}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,4">
You can use any <Bold>.wav</Bold> file as your reminder sound:
                                </TextBlock>
                                <StackPanel Margin="14,0,0,0">
                                    <DockPanel Style="{StaticResource BulletRow}">
                                        <TextBlock Text="1." Style="{StaticResource BulletDot}"/>
                                        <TextBlock Style="{StaticResource BulletText}">Open <Bold>Settings → Hydration</Bold></TextBlock>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource BulletRow}">
                                        <TextBlock Text="2." Style="{StaticResource BulletDot}"/>
                                        <TextBlock Style="{StaticResource BulletText}">In the Sound dropdown choose <Bold>Browse…</Bold></TextBlock>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource BulletRow}">
                                        <TextBlock Text="3." Style="{StaticResource BulletDot}"/>
                                        <TextBlock Style="{StaticResource BulletText}">Pick any <Bold>.wav</Bold> file from your computer</TextBlock>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource BulletRow}">
                                        <TextBlock Text="4." Style="{StaticResource BulletDot}"/>
                                        <TextBlock Style="{StaticResource BulletText}">Click <Bold>Preview</Bold> to test it, then <Bold>Save</Bold></TextBlock>
                                    </DockPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Body}" Foreground="#6B7280" FontSize="12">
Built-in options (Chimes, Chord, Notify) use Windows system sounds and need no extra files.
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Hotkeys -->
                        <Border Style="{StaticResource SectionCard}">
                            <StackPanel>
                                <DockPanel>
                                    <Border Style="{StaticResource SectionAccent}"/>
                                    <TextBlock Text="⌨  Hotkeys" Style="{StaticResource SectionTitle}"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Body}" Margin="0,6,0,6">
Enable in <Bold>Settings → General</Bold> to control the app without opening it:
                                </TextBlock>
                                <Border Background="#EFF6FF" CornerRadius="4" Padding="10,8" Margin="0,0,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                            <RowDefinition/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0" Grid.Column="0" Background="#DBEAFE" CornerRadius="3" Padding="6,2" Margin="0,2,10,2">
                                            <TextBlock Text="Ctrl+Alt+S" FontFamily="Consolas" FontSize="11" Foreground="#1D4ED8"/>
                                        </Border>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="Start / Stop" VerticalAlignment="Center" Foreground="#374151" FontSize="12.5"/>
                                        <Border Grid.Row="1" Grid.Column="0" Background="#DBEAFE" CornerRadius="3" Padding="6,2" Margin="0,2,10,2">
                                            <TextBlock Text="Ctrl+Alt+T" FontFamily="Consolas" FontSize="11" Foreground="#1D4ED8"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="Switch Task" VerticalAlignment="Center" Foreground="#374151" FontSize="12.5"/>
                                        <Border Grid.Row="2" Grid.Column="0" Background="#DBEAFE" CornerRadius="3" Padding="6,2" Margin="0,2,10,2">
                                            <TextBlock Text="Ctrl+Alt+O" FontFamily="Consolas" FontSize="11" Foreground="#1D4ED8"/>
                                        </Border>
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="Open main window" VerticalAlignment="Center" Foreground="#374151" FontSize="12.5"/>
                                        <Border Grid.Row="3" Grid.Column="0" Background="#DBEAFE" CornerRadius="3" Padding="6,2" Margin="0,2,10,2">
                                            <TextBlock Text="Ctrl+Alt+N" FontFamily="Consolas" FontSize="11" Foreground="#1D4ED8"/>
                                        </Border>
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="Add note to running entry" VerticalAlignment="Center" Foreground="#374151" FontSize="12.5"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Your data -->
                        <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1"
                                CornerRadius="6" Padding="14,10" Margin="0,0,0,4">
                            <StackPanel>
                                <DockPanel>
                                    <Border Background="#16A34A" Width="4" CornerRadius="2" Margin="0,0,10,0"/>
                                    <TextBlock Text="🗄  Your data" FontSize="13" FontWeight="SemiBold"
                                               Foreground="#15803D" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#374151" FontSize="12.5" Margin="0,6,0,4">
All data is stored <Bold>locally</Bold> on your machine — nothing is sent to the cloud:
                                </TextBlock>
                                <Border Background="#DCFCE7" CornerRadius="4" Padding="10,6">
                                    <TextBlock Text="%LOCALAPPDATA%\BetterWorkTime\"
                                               FontFamily="Consolas" FontSize="11.5" Foreground="#15803D"/>
                                </Border>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── What's New ── -->
            <TabItem Header="What's New" x:Name="WhatsNewTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,14">
                    <TextBlock x:Name="ChangelogText" TextWrapping="Wrap"
                               FontFamily="Consolas" FontSize="12.5" Foreground="#374151"/>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
