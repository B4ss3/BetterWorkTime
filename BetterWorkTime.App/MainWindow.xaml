<Window x:Class="BetterWorkTime.App.MainWindow"
        WindowStartupLocation="CenterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BetterWorkTime" Height="800" Width="720"
        MinHeight="520" MinWidth="440">

    <DockPanel>

        <!-- ── Header ────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource HeaderBrush}"
                Padding="18,12">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Manage"   Click="ManageButton_Click"
                            Style="{StaticResource BtnHeaderOutline}"
                            Padding="10,5" Margin="0,0,6,0"/>
                    <Button Content="Reports"  Click="ReportsButton_Click"
                            Style="{StaticResource BtnHeaderOutline}"
                            Padding="10,5" Margin="0,0,6,0"/>
                    <Button Content="Settings" Click="SettingsButton_Click"
                            Style="{StaticResource BtnHeaderOutline}"
                            Padding="10,5" Margin="0,0,6,0"/>
                    <Button Content="Help"     Click="HelpButton_Click"
                            Style="{StaticResource BtnHeaderOutline}"
                            Padding="10,5"/>
                </WrapPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="BetterWorkTime"
                               FontSize="17" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="StatusText"
                               FontSize="11.5" Foreground="#8898AA" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ── Top section: timer + context (fixed height) ──────────── -->
        <StackPanel DockPanel.Dock="Top"
                    Background="{StaticResource PageBgBrush}"
                    Margin="18,14,18,0">

            <!-- Timer card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock x:Name="ElapsedText"
                               FontSize="36" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,14"
                               FontFamily="Consolas"/>
                    <UniformGrid Columns="3">
                        <Button x:Name="StartStopButton"
                                Height="38" Margin="0,0,7,0"
                                Click="StartStopButton_Click"
                                Style="{StaticResource BtnGreen}"/>
                        <Button x:Name="PauseResumeButton"
                                Height="38" Margin="0,0,7,0"
                                Click="PauseResumeButton_Click"
                                Style="{StaticResource BtnPurple}"/>
                        <Button x:Name="SwitchTaskButton"
                                Content="Switch Task…"
                                Height="38"
                                Click="SwitchTaskButton_Click"
                                Style="{StaticResource BtnOutline}"/>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Context card -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Project -->
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="PROJECT" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ProjectCombo" DisplayMemberPath="Name"
                                  SelectionChanged="ProjectCombo_SelectionChanged"/>
                    </StackPanel>

                    <!-- Task -->
                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="TASK" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="TaskNameBox"
                                 GotFocus="TaskNameBox_GotFocus"
                                 LostFocus="TaskNameBox_LostFocus"/>
                    </StackPanel>

                    <!-- Tags -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="TAGS" Style="{StaticResource FieldLabel}"/>
                        <Border Background="{StaticResource SubtleBgBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="5"
                                MaxHeight="68">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="5,4">
                                <WrapPanel x:Name="TagsPanel"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- Note -->
                    <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3">
                        <TextBlock Text="NOTE" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="NoteBox"
                                 Height="52" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 LostFocus="NoteBox_LostFocus"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>

        <!-- ── Today timeline (fills remaining space, scrolls) ────────── -->
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="True"
                   Margin="18,0,18,14">

            <!-- Timeline header -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock x:Name="TodayTotalText" DockPanel.Dock="Right"
                           FontSize="12" VerticalAlignment="Center"
                           Foreground="{StaticResource TextMutedBrush}"/>
                <TextBlock Text="Today" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock x:Name="NoEntriesText" DockPanel.Dock="Top"
                       Text="No entries yet today."
                       FontSize="13" FontStyle="Italic"
                       Foreground="{StaticResource TextMutedBrush}"
                       Margin="0,0,0,6"/>

            <!-- Scrollable list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TimelineList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{Binding EntryBorderBrush}"
                                    BorderThickness="{Binding EntryBorderThickness}"
                                    Background="{StaticResource CardBgBrush}"
                                    CornerRadius="6" Margin="0,0,0,6" Padding="12,9">
                                <StackPanel>

                                    <DockPanel>
                                        <Border DockPanel.Dock="Right"
                                                Visibility="{Binding PausedBadgeVisibility}"
                                                Background="#5B4F8A" CornerRadius="3"
                                                Padding="6,2" Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="PAUSED" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                        <Border DockPanel.Dock="Right"
                                                Visibility="{Binding IdleBadgeVisibility}"
                                                Background="#7A6520" CornerRadius="3"
                                                Padding="6,2" Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="IDLE" FontSize="10" FontWeight="SemiBold" Foreground="#F5E090"/>
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding Label}"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Margin="8,0,0,0"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock VerticalAlignment="Center">
                                            <Run Text="{Binding TimeRange}" FontWeight="SemiBold" FontSize="13"
                                                 Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding Duration}" FontSize="12"
                                                 Foreground="{StaticResource TextMutedBrush}"/>
                                        </TextBlock>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding Tags}"
                                                  Visibility="{Binding TagsVisibility}"
                                                  Margin="0,5,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{StaticResource AccentSubtleBrush}"
                                                        BorderBrush="{StaticResource AccentLightBrush}"
                                                        BorderThickness="1" CornerRadius="4"
                                                        Padding="6,2" Margin="0,0,4,2">
                                                    <TextBlock Text="{Binding}" FontSize="10"
                                                               Foreground="{StaticResource AccentBrush}"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding Note}"
                                               Visibility="{Binding NoteVisibility}"
                                               FontSize="12" FontStyle="Italic"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>

                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,7,0,0">
                                        <Button Content="Edit"   Tag="{Binding Id}"
                                                Click="EditEntry_Click"
                                                Style="{StaticResource BtnOutline}"
                                                Padding="8,3" Margin="0,0,4,0" FontSize="11"/>
                                        <Button Content="Split…" Tag="{Binding Id}"
                                                IsEnabled="{Binding CanSplit}"
                                                Click="SplitEntry_Click"
                                                Style="{StaticResource BtnOutline}"
                                                Padding="8,3" Margin="0,0,4,0" FontSize="11"/>
                                        <Button Content="Delete" Tag="{Binding Id}"
                                                Click="DeleteEntry_Click"
                                                Style="{StaticResource BtnDanger}"
                                                Padding="8,3" FontSize="11"/>
                                    </StackPanel>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

    </DockPanel>
</Window>
