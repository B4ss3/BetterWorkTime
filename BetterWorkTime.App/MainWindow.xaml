<Window x:Class="BetterWorkTime.App.MainWindow"
        WindowStartupLocation="CenterScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="BetterWorkTime" Height="720" Width="960"
        MinHeight="520" MinWidth="640">

    <DockPanel>

        <!-- ── Header ────────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="#252B35"
                Height="52">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: logo + status badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="BetterWorkTime"
                               FontSize="16" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center"/>
                    <Border x:Name="StatusBadge" CornerRadius="4" Padding="7,3"
                            Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="Collapsed">
                        <TextBlock x:Name="StatusBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                    </Border>
                </StackPanel>

                <!-- Center: Nav buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NavTimer"     Content="Timer"     Tag="Timer"
                            Click="NavButton_Click" Style="{StaticResource BtnNav}" Margin="2,0"/>
                    <Button x:Name="NavDashboard" Content="Dashboard" Tag="Dashboard"
                            Click="NavButton_Click" Style="{StaticResource BtnNav}" Margin="2,0"/>
                    <Button x:Name="NavReports"   Content="Reports"   Tag="Reports"
                            Click="NavButton_Click" Style="{StaticResource BtnNav}" Margin="2,0"/>
                    <Button x:Name="NavManage"    Content="Manage"    Tag="Manage"
                            Click="NavButton_Click" Style="{StaticResource BtnNav}" Margin="2,0"/>
                    <Button x:Name="NavSettings"  Content="Settings"  Tag="Settings"
                            Click="NavButton_Click" Style="{StaticResource BtnNav}" Margin="2,0"/>
                </StackPanel>

                <!-- Right: Help button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                    <Button Content="Help ↗" Click="HelpButton_Click"
                            Style="{StaticResource BtnHeaderOutline}"
                            Padding="10,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Content area ──────────────────────────────────────────── -->
        <ContentControl x:Name="ViewHost"/>

    </DockPanel>
</Window>
