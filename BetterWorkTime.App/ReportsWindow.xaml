<Window x:Class="BetterWorkTime.App.ReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reports — BetterWorkTime"
        Width="880" Height="640"
        MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">

    <DockPanel>

        <!-- ── Header ───────────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="18,14">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="Export CSV…" Padding="12,6"
                        VerticalAlignment="Center"
                        Style="{StaticResource BtnHeaderOutline}"
                        Click="ExportCsv_Click"/>
                <TextBlock Text="Reports" FontSize="16" FontWeight="Bold" Foreground="White"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- ── Filter bar ───────────────────────────────────────────── -->
        <Border DockPanel.Dock="Top"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="16,10">
            <WrapPanel>

                <!-- Period -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                    <TextBlock Text="Period" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="PeriodCombo" Width="136"
                              SelectionChanged="PeriodCombo_SelectionChanged"/>
                </StackPanel>

                <!-- Custom range -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center"
                            x:Name="CustomRangePanel" Visibility="Collapsed">
                    <TextBlock Text="From" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="FromPicker" Width="120" Margin="0,0,10,0"
                                SelectedDateChanged="DateFilter_Changed"/>
                    <TextBlock Text="To" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker x:Name="ToPicker" Width="120"
                                SelectedDateChanged="DateFilter_Changed"/>
                </StackPanel>

                <!-- Project -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                    <TextBlock Text="Project" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ProjectFilterCombo" Width="150" DisplayMemberPath="Name"
                              SelectionChanged="Filter_Changed"/>
                </StackPanel>

                <!-- Note search -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,4" VerticalAlignment="Center">
                    <TextBlock Text="Note" Style="{StaticResource FieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="NoteSearchBox" Width="130"
                             TextChanged="NoteSearch_Changed"/>
                </StackPanel>

                <!-- Include idle -->
                <CheckBox x:Name="IncludeIdleBox"
                          Content="Include idle" VerticalAlignment="Center"
                          Margin="0,0,14,4"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>

                <!-- Include pauses -->
                <CheckBox x:Name="IncludePausesBox"
                          Content="Include pauses" VerticalAlignment="Center"
                          Margin="0,0,0,4"
                          Checked="Filter_Changed" Unchecked="Filter_Changed"/>

            </WrapPanel>
        </Border>

        <!-- ── Summary bar ──────────────────────────────────────────── -->
        <Border DockPanel.Dock="Bottom"
                Background="{StaticResource SubtleBgBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="16,8">
            <TextBlock x:Name="SummaryText"
                       FontSize="12.5"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       VerticalAlignment="Center"/>
        </Border>

        <!-- ── Tab area ──────────────────────────────────────────────── -->
        <TabControl Margin="0">

            <!-- Entries list -->
            <TabItem Header="Entries">
                <ListView x:Name="EntriesList" BorderThickness="0"
                          Background="{StaticResource SubtleBgBrush}"
                          GridViewColumnHeader.Click="ColumnHeader_Click">
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background"        Value="White"/>
                            <Setter Property="Foreground"        Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="FontSize"          Value="11"/>
                            <Setter Property="FontWeight"        Value="SemiBold"/>
                            <Setter Property="Padding"           Value="10,6"/>
                            <Setter Property="BorderBrush"       Value="{StaticResource BorderBrush}"/>
                            <Setter Property="BorderThickness"   Value="0,0,0,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding"           Value="0"/>
                            <Setter Property="BorderBrush"       Value="{StaticResource PageBgBrush}"/>
                            <Setter Property="BorderThickness"   Value="0,0,0,1"/>
                            <Setter Property="Background"        Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentLightBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn x:Name="ColDate"     Width="92"
                                DisplayMemberBinding="{Binding DateStr}">
                                <GridViewColumnHeader Tag="Date" Content="DATE"/>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColStart"    Width="60"
                                DisplayMemberBinding="{Binding StartStr}">
                                <GridViewColumnHeader Tag="Start" Content="START"/>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColEnd"      Width="60"
                                DisplayMemberBinding="{Binding EndStr}">
                                <GridViewColumnHeader Tag="End" Content="END"/>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColDuration" Width="82"
                                DisplayMemberBinding="{Binding DurationStr}">
                                <GridViewColumnHeader Tag="Duration" Content="DURATION"/>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColProject"  Width="130"
                                DisplayMemberBinding="{Binding ProjectName}">
                                <GridViewColumnHeader Tag="Project" Content="PROJECT"/>
                            </GridViewColumn>
                            <GridViewColumn x:Name="ColTask"     Width="140"
                                DisplayMemberBinding="{Binding TaskName}">
                                <GridViewColumnHeader Tag="Task" Content="TASK"/>
                            </GridViewColumn>
                            <GridViewColumn Header="TAGS"     Width="110"
                                DisplayMemberBinding="{Binding Tags}"/>
                            <GridViewColumn Header="NOTE"     Width="200"
                                DisplayMemberBinding="{Binding Note}"/>
                            <GridViewColumn Header="IDLE"  Width="44"
                                DisplayMemberBinding="{Binding IdleStr}"/>
                            <GridViewColumn Header="PAUSE" Width="50"
                                DisplayMemberBinding="{Binding PauseStr}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>

            <!-- Chart -->
            <TabItem Header="Chart">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Background="{StaticResource SubtleBgBrush}">
                    <StackPanel x:Name="ChartPanel" Margin="18,14,18,18"/>
                </ScrollViewer>
            </TabItem>

            <!-- Project breakdown -->
            <TabItem Header="By Project">
                <ListView x:Name="BreakdownList" BorderThickness="0"
                          Background="{StaticResource SubtleBgBrush}">
                    <ListView.Resources>
                        <Style TargetType="GridViewColumnHeader">
                            <Setter Property="Background"        Value="White"/>
                            <Setter Property="Foreground"        Value="{StaticResource TextSecondaryBrush}"/>
                            <Setter Property="FontSize"          Value="11"/>
                            <Setter Property="FontWeight"        Value="SemiBold"/>
                            <Setter Property="Padding"           Value="10,6"/>
                            <Setter Property="BorderBrush"       Value="{StaticResource BorderBrush}"/>
                            <Setter Property="BorderThickness"   Value="0,0,0,1"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        </Style>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding"      Value="0"/>
                            <Setter Property="Background"   Value="White"/>
                            <Setter Property="BorderBrush"  Value="{StaticResource PageBgBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource AccentSubtleBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListView.Resources>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="PROJECT"  Width="220"
                                DisplayMemberBinding="{Binding ProjectName}"/>
                            <GridViewColumn Header="DURATION" Width="110"
                                DisplayMemberBinding="{Binding DurationStr}"/>
                            <GridViewColumn Header="SHARE"    Width="90"
                                DisplayMemberBinding="{Binding ShareStr}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </TabItem>

        </TabControl>

    </DockPanel>
</Window>
