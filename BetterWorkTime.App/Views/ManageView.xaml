<UserControl x:Class="BetterWorkTime.App.Views.ManageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <TabControl>

        <!-- ── Projects ────────────────────────────────────────── -->
        <TabItem Header="Projects">
            <DockPanel Margin="16,12,16,16">

                <!-- Add row at bottom -->
                <Border DockPanel.Dock="Bottom"
                        Background="White" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                    <DockPanel>
                        <Button Content="Add Project" DockPanel.Dock="Right"
                                Click="AddProject_Click"
                                Style="{StaticResource BtnBlue}" Padding="12,6"/>
                        <ComboBox x:Name="NewProjectColor" Width="120" Margin="0,0,8,0"
                                  DisplayMemberPath="Label" DockPanel.Dock="Right"/>
                        <TextBox x:Name="NewProjectName"
                                 KeyDown="NewProjectName_KeyDown"
                                 Margin="0,0,8,0"/>
                    </DockPanel>
                </Border>

                <!-- Grid -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <DataGrid x:Name="ProjectsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource PageBgBrush}"
                              RowBackground="White"
                              AlternatingRowBackground="{StaticResource SubtleBgBrush}"
                              ColumnHeaderHeight="34">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"   Value="{StaticResource SubtleBgBrush}"/>
                                <Setter Property="Foreground"   Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize"     Value="11"/>
                                <Setter Property="FontWeight"   Value="SemiBold"/>
                                <Setter Property="Padding"      Value="10,0"/>
                                <Setter Property="BorderBrush"  Value="{StaticResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME"  Binding="{Binding Name}" Width="*"
                                                ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                            <DataGridTemplateColumn Header="COLOR" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="28" Height="16" CornerRadius="3"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding ColorValue}"/>
                                            </Border.Background>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="STATUS" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ArchivedLabel}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,3">
                                            <Button Content="Rename"
                                                    Tag="{Binding Id}"
                                                    Click="RenameProject_Click"
                                                    Style="{StaticResource BtnOutline}"
                                                    Padding="6,3" Margin="0,0,4,0" FontSize="11"/>
                                            <Button Content="{Binding ToggleLabel}"
                                                    Tag="{Binding Id}"
                                                    Click="ToggleProjectArchive_Click"
                                                    Style="{StaticResource BtnOutline}"
                                                    Padding="6,3" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </TabItem>

        <!-- ── Tags ──────────────────────────────────────────────── -->
        <TabItem Header="Tags">
            <DockPanel Margin="16,12,16,16">

                <!-- Add row at bottom -->
                <Border DockPanel.Dock="Bottom"
                        Background="White" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,0">
                    <DockPanel>
                        <Button Content="Add Tag" DockPanel.Dock="Right"
                                Click="AddTag_Click"
                                Style="{StaticResource BtnBlue}" Padding="12,6"/>
                        <ComboBox x:Name="NewTagColor" Width="120" Margin="0,0,8,0"
                                  DisplayMemberPath="Label" DockPanel.Dock="Right"/>
                        <TextBox x:Name="NewTagName"
                                 KeyDown="NewTagName_KeyDown"
                                 Margin="0,0,8,0"/>
                    </DockPanel>
                </Border>

                <!-- Grid -->
                <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="6">
                    <DataGrid x:Name="TagsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource PageBgBrush}"
                              RowBackground="White"
                              AlternatingRowBackground="{StaticResource SubtleBgBrush}"
                              ColumnHeaderHeight="34">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background"   Value="{StaticResource SubtleBgBrush}"/>
                                <Setter Property="Foreground"   Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontSize"     Value="11"/>
                                <Setter Property="FontWeight"   Value="SemiBold"/>
                                <Setter Property="Padding"      Value="10,0"/>
                                <Setter Property="BorderBrush"  Value="{StaticResource BorderBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME"  Binding="{Binding Name}" Width="*"/>
                            <DataGridTemplateColumn Header="COLOR" Width="64">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="28" Height="16" CornerRadius="3"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                BorderThickness="1" BorderBrush="{StaticResource BorderBrush}">
                                            <Border.Background>
                                                <SolidColorBrush Color="{Binding ColorValue}"/>
                                            </Border.Background>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="STATUS" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ArchivedLabel}"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   FontSize="12"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,3">
                                            <Button Content="Rename"
                                                    Tag="{Binding Id}"
                                                    Click="RenameTag_Click"
                                                    Style="{StaticResource BtnOutline}"
                                                    Padding="6,3" Margin="0,0,4,0" FontSize="11"/>
                                            <Button Content="{Binding ToggleLabel}"
                                                    Tag="{Binding Id}"
                                                    Click="ToggleTagArchive_Click"
                                                    Style="{StaticResource BtnOutline}"
                                                    Padding="6,3" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </TabItem>

    </TabControl>
</UserControl>
